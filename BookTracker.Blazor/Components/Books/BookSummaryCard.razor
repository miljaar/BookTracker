@using BookTracker.Blazor.Models.Books

<article>
    <h2>@Book.Title</h2>
    @if (showAuthors)
    {
        <p>@Book.Author</p>
    }
    <button @onclick="SelectBook" type="button">Selecteer</button>
</article>

@code {
    [Parameter]
    public required BookSummary Book { get; set; }

    [Parameter]
    public bool showAuthors { get; set; } = true;
    [Parameter]
    public EventCallback<int> OnSelected { get; set; }

    private Task SelectBook() => OnSelected.InvokeAsync(Book.Id);

}